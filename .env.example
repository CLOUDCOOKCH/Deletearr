DELETARR_UID=10001
DELETARR_GID=10001
DELETARR_BIND=127.0.0.1
DELETARR_PORT=8980
DELETARR_CONFIG_HOST=./config
DELETARR_MOVIES_HOST=/srv/media/movies
DELETARR_TV_HOST=/srv/media/tv
DELETARR_SECURE_COOKIE=false
# DELETARR_ORIGIN=https://deletarr.example.net
# Optional application environment variables (also add them to Compose environment):
# DELETARR_PLEX_URL=http://plex:32400
# DELETARR_PLEX_SECRET_FILE=/run/secrets/plex_token
# DELETARR_PLEX_TRUST_PRIVATE=true
# Same URL, SECRET or SECRET_FILE, TRUST_PRIVATE keys for RADARR, SONARR, SEERR.
